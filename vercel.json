{
  "rewrites": [
    {
      "source": "/((?!OneSignalSDKWorker\\.js|OneSignalSDK\\.sw\\.js|api/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/send-notification.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/OneSignalSDKWorker.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}

